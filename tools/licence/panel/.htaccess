# Ship this along with the panel when the host forces everything into the web
# root (x10's free tier gives you public_html and little else). It does three
# things, and the third one matters most:
#
#   1. the app posts to /connect, so map that to connect.php - the URL the APK
#      was built with does not need editing;
#   2. lib.php and config.php are includes, never URLs;
#   3. keep the directory listing off, so nobody can browse to keys.json by
#      guessing a folder name.

Options -Indexes

# `Options -Indexes` above is what turns "/" into a 403 when the directory has
# no index document - and on a shared host the default DirectoryIndex list is
# often just `index.html index.htm`, so index.php was never even looked at.
# Name it explicitly: the panel root then always answers with index.php (which
# redirects to admin.php) instead of "403 Forbidden".
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    # /connect and /connect/ both land on the endpoint.
    RewriteRule ^connect/?$ connect.php [L]
</IfModule>

# Apache 2.4
<IfModule mod_authz_core.c>
    <FilesMatch "^(lib|config)\.php$">
        Require all denied
    </FilesMatch>
</IfModule>
# Apache 2.2
<IfModule !mod_authz_core.c>
    <FilesMatch "^(lib|config)\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Belt for hosts that ignore the per-directory rules in private/ and data/:
# no response may ever carry the key or the store, whatever the extension.
<IfModule mod_headers.c>
    <FilesMatch "\.(pem|json)$">
        Header always set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>
