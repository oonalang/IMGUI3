# keys.json is every customer's key, its bound device and its expiry. Serving it
# would hand out working licences to anyone who asked for the file.
#
# lib.php creates this directory on first use and writes keys.json; Apache reads
# this file. If the host strips dotfiles on FTP upload, verify by requesting
# /data/keys.json - it must answer 403, not the JSON.

Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
